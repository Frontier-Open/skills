{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierworld.ai/schemas/frontier-signals/article.schema.json",
  "title": "Frontier Signals article",
  "description": "Normative contract for new Frontier Signals canonical articles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "series",
    "publisher",
    "author",
    "id",
    "date",
    "slug",
    "timezone",
    "generated_at",
    "status",
    "mode",
    "format",
    "title",
    "title_candidates",
    "subtitle",
    "thesis",
    "reader_payoff",
    "hook",
    "excerpt",
    "reading_minutes",
    "word_count",
    "canonical_url",
    "story_keys",
    "angle_key",
    "continuation_of",
    "material_update",
    "counterargument",
    "watchlist",
    "intro",
    "intro_source_ids",
    "sections",
    "conclusion",
    "sources",
    "fact_check",
    "media",
    "distribution",
    "warnings",
    "corrections"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "series": { "const": "Frontier Signals" },
    "publisher": { "const": "Frontier World" },
    "author": { "const": "Frontier World" },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "timezone": { "const": "Asia/Shanghai" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["draft", "reviewed", "approved", "published"]
    },
    "mode": {
      "enum": ["quick", "deep"]
    },
    "format": {
      "description": "Legacy renderer compatibility field; mode is authoritative.",
      "enum": ["commentary", "analysis", "deep-dive"]
    },
    "title": {
      "type": "string",
      "minLength": 12,
      "maxLength": 32
    },
    "title_candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/titleCandidate" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "type": { "const": "factual" } },
            "required": ["type"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "type": { "const": "judgment" } },
            "required": ["type"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "type": { "const": "question" } },
            "required": ["type"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "subtitle": {
      "type": "string",
      "minLength": 12,
      "maxLength": 100
    },
    "thesis": {
      "type": "string",
      "minLength": 20
    },
    "reader_payoff": {
      "type": "string",
      "minLength": 15,
      "maxLength": 120
    },
    "hook": { "$ref": "#/$defs/hook" },
    "excerpt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 180
    },
    "reading_minutes": {
      "type": "integer"
    },
    "word_count": {
      "description": "Computed visible non-whitespace character count across intro, section paragraphs/callouts/points, and conclusion paragraphs; excludes metadata, captions, and sources.",
      "type": "integer"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.+/$"
    },
    "story_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "angle_key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "continuation_of": {
      "type": ["string", "null"]
    },
    "material_update": {
      "type": ["string", "null"]
    },
    "counterargument": {
      "oneOf": [
        { "$ref": "#/$defs/counterargument" },
        { "type": "null" }
      ]
    },
    "watchlist": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/watchItem" }
    },
    "intro": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "intro_source_ids": { "$ref": "#/$defs/sourceIds" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "conclusion": { "$ref": "#/$defs/conclusion" },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "fact_check": {
      "type": "array",
      "items": { "$ref": "#/$defs/factCheck" }
    },
    "media": { "$ref": "#/$defs/mediaSet" },
    "distribution": { "$ref": "#/$defs/distribution" },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "corrections": {
      "type": "array",
      "items": { "$ref": "#/$defs/correction" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "quick" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "format": { "const": "analysis" },
          "word_count": { "minimum": 1400, "maximum": 2200 },
          "reading_minutes": { "minimum": 5, "maximum": 8 },
          "sections": {
            "minItems": 3,
            "maxItems": 4,
            "contains": {
              "type": "object",
              "required": ["image"]
            },
            "minContains": 1,
            "maxContains": 3
          },
          "sources": { "minItems": 3 },
          "fact_check": { "minItems": 3 }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "deep" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "format": { "const": "deep-dive" },
          "word_count": { "minimum": 3200, "maximum": 5000 },
          "reading_minutes": { "minimum": 12, "maximum": 18 },
          "counterargument": { "$ref": "#/$defs/counterargument" },
          "sections": {
            "minItems": 4,
            "maxItems": 6,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": { "role": { "const": "counterargument" } },
                  "required": ["role"]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["image"]
                },
                "minContains": 3,
                "maxContains": 6
              }
            ]
          },
          "sources": { "minItems": 6 },
          "fact_check": { "minItems": 6 }
        }
      }
    },
    {
      "properties": {
        "sections": {
          "contains": {
            "type": "object",
            "properties": {
              "image": {
                "type": "object",
                "properties": { "purpose": { "const": "atmosphere" } },
                "required": ["purpose"]
              }
            },
            "required": ["image"]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["reviewed", "approved", "published"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "warnings": { "maxItems": 0 },
          "fact_check": {
            "items": {
              "type": "object",
              "properties": {
                "status": { "enum": ["verified", "qualified"] }
              },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "continuation_of": { "type": "string", "minLength": 1 }
        },
        "required": ["continuation_of"]
      },
      "then": {
        "properties": {
          "material_update": { "type": "string", "minLength": 12 }
        }
      },
      "else": {
        "properties": {
          "material_update": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "titleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "claim_check"],
      "properties": {
        "type": { "enum": ["factual", "judgment", "question"] },
        "text": { "type": "string", "minLength": 12, "maxLength": 32 },
        "claim_check": { "type": "string", "minLength": 12 }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "tension", "judgment"],
      "properties": {
        "event": { "type": "string", "minLength": 12 },
        "tension": { "type": "string", "minLength": 12 },
        "judgment": { "type": "string", "minLength": 12 }
      }
    },
    "counterargument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence", "boundary", "response", "source_ids"],
      "properties": {
        "claim": { "type": "string", "minLength": 12 },
        "evidence": { "type": "string", "minLength": 12 },
        "boundary": { "type": "string", "minLength": 12 },
        "response": { "type": "string", "minLength": 12 },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "watchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator", "why_it_matters", "source_ids"],
      "properties": {
        "indicator": { "type": "string", "minLength": 8 },
        "why_it_matters": { "type": "string", "minLength": 8 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "title", "role", "paragraphs", "source_ids"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 4 },
        "role": {
          "enum": ["context", "evidence", "mechanism", "counterargument", "implication", "watchlist"]
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 8 }
        },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "callout": { "type": "string", "minLength": 8 },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        },
        "image": { "$ref": "#/$defs/mediaItem" }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs", "source_ids"],
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 8 }
        },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "question": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chain_id", "publisher", "title", "url", "accessed_at", "source_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "chain_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "accessed_at": { "type": "string", "format": "date-time" },
        "source_type": { "enum": ["primary", "reporting", "analysis", "social"] }
      }
    },
    "factCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "kind",
        "status",
        "source_ids",
        "high_risk",
        "independent_source_count",
        "note"
      ],
      "properties": {
        "claim": { "type": "string", "minLength": 8 },
        "kind": { "enum": ["fact", "attributed-reporting", "interpretation", "recommendation"] },
        "status": { "enum": ["pending", "verified", "qualified", "rejected"] },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "high_risk": { "type": "boolean" },
        "independent_source_count": { "type": "integer", "minimum": 1 },
        "note": { "type": "string", "minLength": 4 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "high_risk": { "const": true } },
            "required": ["high_risk"]
          },
          "then": {
            "properties": {
              "source_ids": { "minItems": 2 },
              "independent_source_count": { "minimum": 2 }
            }
          }
        }
      ]
    },
    "mediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt", "credit", "purpose", "rights", "generated"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!https?://|/)(?!.*\\.\\.)\\S+$"
        },
        "alt": { "type": "string", "minLength": 4 },
        "caption": { "type": "string" },
        "credit": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "purpose": { "enum": ["brand", "evidence", "explanation", "scene", "atmosphere"] },
        "rights": { "type": "string", "minLength": 4 },
        "generated": { "type": "boolean" },
        "prompt_note": { "type": "string", "minLength": 4 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "generated": { "const": true } },
            "required": ["generated"]
          },
          "then": { "required": ["prompt_note"] },
          "else": { "required": ["source_url"] }
        }
      ]
    },
    "mediaSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover", "og"],
      "properties": {
        "cover": { "$ref": "#/$defs/mediaItem" },
        "og": { "$ref": "#/$defs/mediaItem" }
      }
    },
    "channelState": {
      "enum": ["draft", "reviewed", "approved", "published", "failed"]
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "wechat", "feishu"],
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "url"],
          "properties": {
            "status": { "$ref": "#/$defs/channelState" },
            "url": { "type": ["string", "null"] }
          }
        },
        "wechat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "draft_id"],
          "properties": {
            "status": { "$ref": "#/$defs/channelState" },
            "draft_id": { "type": ["string", "null"] }
          }
        },
        "feishu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "document_url"],
          "properties": {
            "status": { "$ref": "#/$defs/channelState" },
            "document_url": { "type": ["string", "null"] }
          }
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corrected_at", "claim", "reason", "source_ids"],
      "properties": {
        "corrected_at": { "type": "string", "format": "date-time" },
        "claim": { "type": "string", "minLength": 4 },
        "reason": { "type": "string", "minLength": 4 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    }
  }
}
